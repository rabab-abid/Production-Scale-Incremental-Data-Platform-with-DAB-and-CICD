{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "musicmetadataadf"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_azuresqldb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresqldb'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://musicmetadataadls.dfs.core.windows.net/"
		},
		"ls_azurekeyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://musicmetadataKV.vault.azure.net/"
		},
		"ls_azuresqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "musicmetadataserver.database.windows.net"
		},
		"ls_azuresqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "musicmetadatadb"
		},
		"ls_azuresqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminrabab"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "musicmetadataadf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_accountKey": {
						"value": "[parameters('ls_adls_accountKey')]"
					},
					"ls_azuresqldb_password": {
						"value": "[parameters('ls_azuresqldb_password')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_azurekeyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_azurekeyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_azuresqldb_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_server')]"
					},
					"ls_azuresqldb_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_database')]"
					},
					"ls_azuresqldb_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}